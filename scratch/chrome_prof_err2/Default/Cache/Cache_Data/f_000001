  <!-- 2. Skip intro & mobile nav -->
  <script>
    document.getElementById('skip-intro')?.addEventListener('click', () => {
      document.getElementById('enter-btn')?.click();
    });
    document.querySelector('.nav-menu-btn')?.addEventListener('click', function() {
      const expanded = this.getAttribute('aria-expanded') === 'true';
      this.setAttribute('aria-expanded', String(!expanded));
      this.classList.toggle('open');
      document.getElementById('nav-link-list')?.classList.toggle('open');
    });
    document.querySelectorAll('#nav-link-list a').forEach(a => {
      a.addEventListener('click', () => {
        document.querySelector('.nav-menu-btn')?.classList.remove('open');
        document.querySelector('.nav-menu-btn')?.setAttribute('aria-expanded','false');
        document.getElementById('nav-link-list')?.classList.remove('open');
      });
    });
  </script>

  <!-- 3. GSAP — cinematic choreography for every section -->
  <script>
    window.addEventListener('load', () => {
      if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;
      gsap.registerPlugin(ScrollTrigger);

      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReduced) return;

      /* Wait for main content to become visible */
      const waitForMain = setInterval(() => {
        const main = document.getElementById('main-content');
        if (!main || main.classList.contains('hidden')) return;
        clearInterval(waitForMain);
        setTimeout(initGSAP, 150);
      }, 200);

      function initGSAP() {

        /* ── 1. HERO — Editorial scale-down reveal ── */
        const heroBg = document.getElementById('hero-bg');
        if (heroBg) {
          gsap.fromTo(heroBg,
            { scale: 1.06, opacity: 0.7 },
            { scale: 1,   opacity: 1,
              duration: 1.6, ease: 'power3.out' });
        }

        /* Hero left/right entrance */
        const heroLeft  = document.querySelector('.hero-left');
        const heroRight = document.querySelector('.hero-right');
        if (heroLeft) gsap.fromTo(heroLeft,
          { opacity: 0, x: -50 },
          { opacity: 1, x: 0, duration: 1.4, ease: 'expo.out', delay: 0.3 });
        if (heroRight) gsap.fromTo(heroRight,
          { opacity: 0, x: 50, clipPath: 'inset(0 30% 0 0)' },
          { opacity: 1, x: 0,  clipPath: 'inset(0 0% 0 0)',
            duration: 1.6, ease: 'expo.out', delay: 0.5 });

        /* Hero decorative line draw */
        const heroDeco = document.querySelector('.hero-deco-line path');
        if (heroDeco) {
          const len = heroDeco.getTotalLength?.() || 120;
          gsap.set(heroDeco, { strokeDasharray: len, strokeDashoffset: len });
          gsap.to(heroDeco, { strokeDashoffset: 0, duration: 1.2, delay: 0.8, ease: 'expo.out' });
        }

        /* ── 2. HERO PARALLAX ── */
        if (heroBg) {
          gsap.to(heroBg, {
            y: '25%', ease: 'none',
            scrollTrigger: { trigger: '#hero', start: 'top top', end: 'bottom top', scrub: true },
          });
        }

        /* ── 3. SECTION HEADINGS — clip-path wipe reveal ── */
        document.querySelectorAll('.section-header h2, .mosaic-heading-wrap h2').forEach(el => {
          gsap.fromTo(el,
            { opacity: 0, y: 36, clipPath: 'inset(0 0 85% 0)' },
            { opacity: 1, y: 0,  clipPath: 'inset(0 0 0% 0)',
              duration: 1.1, ease: 'expo.out',
              scrollTrigger: { trigger: el, start: 'top 88%', once: true }
            }
          );
        });

        /* ── 4. UNIVERSE — SVG constellation draw + node stagger ── */
        const constPaths = document.querySelectorAll('#constellation-paths line');
        constPaths.forEach((line, i) => {
          const len = line.getTotalLength?.() || 200;
          gsap.set(line, { strokeDasharray: len, strokeDashoffset: len, opacity: 0 });
          gsap.to(line, {
            strokeDashoffset: 0, opacity: 1,
            duration: 1.8, delay: 0.4 + i * 0.3, ease: 'expo.out',
            scrollTrigger: { trigger: '#universe', start: 'top 80%', once: true },
          });
        });

        const canvas3D = document.getElementById('universe-3d-canvas');
        if (canvas3D) {
          gsap.fromTo(canvas3D,
            { opacity: 0, scale: 0.94 },
            { opacity: 1, scale: 1, duration: 1.5, ease: 'power3.out',
              scrollTrigger: { trigger: '#universe', start: 'top 80%', once: true }
            }
          );
        }

        const planetCards = document.querySelectorAll('.universe-planet-card');
        if (planetCards.length) {
          gsap.set(planetCards, { opacity: 0, y: 25, scale: 0.95 });
          ScrollTrigger.create({
            trigger: '#universe', start: 'top 75%', once: true,
            onEnter: () => {
              gsap.to(planetCards, {
                opacity: 1, y: 0, scale: 1,
                duration: 1.0, ease: 'power3.out',
                stagger: { each: 0.12 },
              });
            },
          });
        }

        /* Universe mouse parallax */
        const universeSection = document.getElementById('universe');
        if (universeSection) {
          let ux = 0, uy = 0;
          let ticking = false;
          universeSection.addEventListener('mousemove', e => {
            const rect = universeSection.getBoundingClientRect();
            ux = (e.clientX - rect.left) / rect.width - 0.5;
            uy = (e.clientY - rect.top)  / rect.height - 0.5;
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(() => {
                universeNodes.forEach((node, i) => {
                  const depth = 0.8 + i * 0.3;
                  gsap.to(node, {
                    x: ux * 22 * depth, y: uy * 14 * depth,
                    duration: 1.2, ease: 'power2.out', overwrite: 'auto',
                  });
                });
                ticking = false;
              });
            }
          }, { passive: true });
          universeSection.addEventListener('mouseleave', () => {
            universeNodes.forEach(node => {
              gsap.to(node, { x: 0, y: 0, duration: 1.2, ease: 'power2.out', overwrite: 'auto' });
            });
          });
        }

        /* ── 5. GALLERY — Directional clip-path reveals ── */
        const galleryItems = document.querySelectorAll('#gallery-grid .gallery-item');
        const origins = ['inset(100% 0 0 0)','inset(0 100% 0 0)','inset(0 0 100% 0)','inset(0 0 0 100%)'];
        galleryItems.forEach((el, i) => {
          el.classList.remove('reveal-scale');
          gsap.fromTo(el,
            { clipPath: origins[i % origins.length], scale: 1.05, opacity: 0.8 },
            {
              clipPath: 'inset(0 0 0 0)', scale: 1, opacity: 1,
              duration: 1.15, ease: 'expo.out',
              delay: (i % 3) * 0.1,
              scrollTrigger: { trigger: el, start: 'top 92%', once: true },
            }
          );
        });

        /* ── 6. SCRAPBOOK — 4-direction card entrances + rotation ── */
        const scrapCards = document.querySelectorAll('#scrapbook-grid .scrap-card');
        scrapCards.forEach((card, i) => {
          card.classList.remove('reveal-up');
          const fromX = i % 3 === 0 ? -55 : i % 3 === 2 ? 55 : 0;
          const fromY = i % 3 === 1 ? 65 : 32;
          const rots  = [-2.4, 1.8, -1.0, 2.6, -1.6];
          const rot   = rots[i % rots.length];
          gsap.fromTo(card,
            { opacity: 0, x: fromX, y: fromY, scale: 0.9, rotate: rot > 0 ? rot + 5 : rot - 5 },
            {
              opacity: 1, x: 0, y: 0, scale: 1, rotate: rot,
              duration: 1.1, ease: 'power3.out', delay: (i % 2) * 0.12,
              scrollTrigger: { trigger: card, start: 'top 90%', once: true },
            }
          );
        });

        /* ── 7. MOSAIC — Center-outward cascade ── */
        const mosaicTiles = document.querySelectorAll('#mosaic-grid .mosaic-tile');
        mosaicTiles.forEach(t => t.classList.remove('reveal-scale'));
        gsap.set(mosaicTiles, { opacity: 0, scale: 0.86 });
        ScrollTrigger.create({
          trigger: '#mosaic-grid', start: 'top 80%', once: true,
          onEnter: () => gsap.to(mosaicTiles, {
            opacity: 1, scale: 1, duration: 0.72, ease: 'back.out(1.3)',
            stagger: { each: 0.065, from: 'center' },
          }),
        });

        /* Mosaic hover depth effect */
        mosaicTiles.forEach(tile => {
          tile.addEventListener('mouseenter', () => {
            const others = [...mosaicTiles].filter(t => t !== tile);
            gsap.to(tile,   { scale: 1.03, zIndex: 5, duration: 0.4, ease: 'power2.out' });
            gsap.to(others, { scale: 0.97, opacity: 0.78, duration: 0.4, ease: 'power2.out' });
          });
          tile.addEventListener('mouseleave', () => {
            gsap.to(mosaicTiles, { scale: 1, opacity: 1, zIndex: 1, duration: 0.5, ease: 'power2.inOut' });
          });
        });

        /* ── 8. SECRET — Envelope rise ── */
        const secretEnv = document.querySelector('.secret-envelope');
        if (secretEnv) {
          gsap.fromTo(secretEnv,
            { opacity: 0, y: 55, scale: 0.88, rotate: -2 },
            {
              opacity: 1, y: 0, scale: 1, rotate: 0,
              duration: 1.4, ease: 'expo.out',
              scrollTrigger: { trigger: '#secret', start: 'top 72%', once: true },
            }
          );
        }

        /* ── 9. LETTER — Envelope wrapper rise ── */
        const letterWrap = document.querySelector('.letter-envelope-wrap');
        if (letterWrap) {
          letterWrap.classList.remove('reveal-scale');
          gsap.fromTo(letterWrap,
            { opacity: 0, y: 60, scale: 0.92 },
            {
              opacity: 1, y: 0, scale: 1,
              duration: 1.35, ease: 'power4.out',
              scrollTrigger: { trigger: '#letter-section', start: 'top 72%', once: true },
            }
          );
        }

        /* ── 10. FINAL — 9-step cinematic timeline ── */
        const finalFrame = document.querySelector('#final-scene .final-photo-frame');
        if (finalFrame) {
          finalFrame.classList.remove('reveal-scale');
          const tl = gsap.timeline({
            scrollTrigger: { trigger: '#final-scene', start: 'top 72%', once: true },
          });
          tl.fromTo(finalFrame,
              { clipPath: 'inset(18% 12% 18% 12%)', scale: 1.08, opacity: 0.55 },
              { clipPath: 'inset(0% 0% 0% 0%)',     scale: 1,    opacity: 1,
                duration: 1.55, ease: 'expo.out' })
            .fromTo('.final-glow-orb',
              { opacity: 0, scale: 0.6 },
              { opacity: 1, scale: 1, duration: 1.2, ease: 'power3.out' }, '-=1.0')
            .fromTo('#final-scene .t-eyebrow',
              { opacity: 0, y: 16 },
              { opacity: 1, y: 0, duration: 0.75, ease: 'power3.out' }, '-=0.5')
            .fromTo('#final-heading',
              { opacity: 0, y: 28, clipPath: 'inset(0 0 65% 0)' },
              { opacity: 1, y: 0,  clipPath: 'inset(0 0 0% 0)',
                duration: 1.0, ease: 'expo.out' }, '-=0.3')
            .fromTo('#final-body',
              { opacity: 0, y: 18 },
              { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out' }, '-=0.35')
            .fromTo('#final-signature',
              { opacity: 0, y: 16, scale: 0.94 },
              { opacity: 1, y: 0,  scale: 1, duration: 0.7, ease: 'back.out(1.4)' }, '-=0.3')
            .fromTo('#explore-again-btn',
              { opacity: 0, y: 14 },
              { opacity: 1, y: 0, duration: 0.6, ease: 'power3.out' }, '-=0.25');
        }

        /* ── 11. NAV PROGRESS BAR ── */
        const progressBar = document.querySelector('.nav-progress-bar');
        if (progressBar) {
          gsap.to(progressBar, {
            scaleX: 1,
            ease: 'none',
            scrollTrigger: {
              trigger: 'body', start: 'top top', end: 'bottom bottom', scrub: true,
            },
          });
        }

      } /* end initGSAP */
    });
  </script>

