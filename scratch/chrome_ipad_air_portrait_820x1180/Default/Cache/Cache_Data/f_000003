  color: var(--soft-caramel);
  opacity: 0.88;
  text-transform: uppercase;
  margin-bottom: 0.4rem;
}

.letter-heading {
  font-family: var(--font-display);
  font-size: 1.95rem;
  font-weight: 400;
  font-style: italic;
  color: var(--deep-espresso);
  letter-spacing: 0.02em;
  margin: 0;
}

/* Paragraphs */
.letter-paragraphs-container {
  position: relative;
  z-index: 2;
  text-align: left;
}

.letter-para {
  font-family: var(--font-heading);
  font-size: 1.1rem;
  line-height: 2.05;
  color: #523D2D;
  margin-bottom: 1.15rem;
  opacity: 0.95;
}

.letter-para--greeting {
  font-size: 1.25rem;
  font-style: italic;
  color: #422B1A;
  font-weight: 500;
  margin-bottom: 0.85rem;
}

/* Footer & Signature */
.letter-footer {
  position: relative;
  z-index: 2;
  margin-top: 1.8rem;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.letter-footer-flourish {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 1.2rem;
  color: var(--soft-caramel);
  opacity: 0.45;
  font-size: 0.75rem;
}
.letter-footer-flourish::before,
.letter-footer-flourish::after {
  content: '';
  flex: 1;
  max-width: 60px;
  height: 1px;
  background: rgba(189, 149, 107, 0.35);
  margin: 0 10px;
}

.letter-signature-wrap {
  text-align: right;
  padding-right: 0.5rem;
}

.letter-signature-line {
  width: 90px;
  height: 1px;
  background: rgba(189, 149, 107, 0.4);
  margin: 0 0 0.5rem auto;
}

.letter-signature {
  font-family: 'Dancing Script', cursive;
  font-size: 1.6rem;
  font-weight: 600;
  color: #724E34;
  letter-spacing: 0.02em;
  margin: 0;
}

/* Ornate Close Button */
.letter-close-btn {
  position: absolute;
  top: 18px;
  right: 18px;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: 1px solid rgba(189, 149, 107, 0.4);
  background: rgba(255, 253, 248, 0.92);
  color: var(--chestnut);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.8rem;
  cursor: pointer;
  z-index: 10;
  transition: all 0.25s ease;
  box-shadow: 0 2px 6px rgba(73, 50, 36, 0.1);
}
.letter-close-btn:hover {
  background: var(--card-primary);
  border-color: var(--warm-caramel);
  color: var(--deep-espresso);
  transform: rotate(90deg) scale(1.1);
  box-shadow: 0 4px 12px rgba(73, 50, 36, 0.2);
}

/* ════════════════════════════════════════════════
   LIGHTBOX
════════════════════════════════════════════════ */
#lightbox {
  position: fixed;
  inset: 0;
  z-index: var(--z-overlay);
  background: rgba(73, 50, 36, 0.92);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.5s var(--ease-smooth);
}
#lightbox.open { opacity: 1; pointer-events: all; }

.lightbox-inner {
  position: relative;
  width: 90vw;
  max-width: 1000px;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.lightbox-img {
  display: block;
  max-width: 100%;
  max-height: 78vh;
  object-fit: contain;
  border: 1.5px solid rgba(189, 149, 107, 0.25);
  box-shadow: 0 30px 80px rgba(0,0,0,0.55);
  opacity: 0;
  transition: opacity 0.45s;
}
.lightbox-img.loaded { opacity: 1; }

.lightbox-caption {
  margin-top: var(--s-3);
  font-family: var(--font-body);
  font-size: 0.72rem;
  letter-spacing: 0.1em;
  color: rgba(216, 185, 144, 0.85);
  text-align: center;
}
.lightbox-counter {
  font-family: var(--font-nav);
  font-size: 0.55rem;
  letter-spacing: 0.2em;
  color: rgba(189, 149, 107, 0.55);
  margin-top: 0.5rem;
  text-align: center;
}

.lightbox-close {
  position: absolute;
  top: -3rem; right: 0;
  font-family: var(--font-nav);
  font-size: 0.6rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: rgba(189, 149, 107, 0.75);
  display: flex; align-items: center; gap: var(--s-1);
  transition: color 0.3s;
}
.lightbox-close:hover { color: var(--champagne); }

.lightbox-btn {
  position: absolute;
  top: 50%; transform: translateY(-50%);
  width: 44px; height: 44px;
  border-radius: 50%;
  background: rgba(73, 50, 36, 0.45);
  border: 1px solid rgba(189, 149, 107, 0.28);
  color: var(--champagne);
  font-size: 1.1rem;
  display: flex; align-items: center; justify-content: center;
  transition: background 0.3s, transform 0.3s;
  backdrop-filter: blur(8px);
}
.lightbox-btn:hover { background: rgba(73, 50, 36, 0.75); transform: translateY(-50%) scale(1.1); }
#lb-prev { left: -4.5rem; }
#lb-next { right: -4.5rem; }
.lightbox-btn[disabled] { opacity: 0.3; }

/* ════════════════════════════════════════════════
   FINAL SCENE — CINEMATIC CLOSING
════════════════════════════════════════════════ */
#final-scene {
  background: radial-gradient(ellipse at 60% 30%,
    rgba(216, 185, 144, 0.35) 0%,
    var(--ivory) 50%,
    var(--cream) 100%
  );
  position: relative;
  min-height: 100vh;
}

#final-canvas {
  position: absolute;
  inset: 0;
  width: 100%; height: 100%;
  pointer-events: none;
  z-index: 1;
}

.final-glow-orb {
  position: absolute;
  top: 22%; left: 50%;
  transform: translateX(-50%);
  width: 50vmax; height: 50vmax;
  border-radius: 50%;
  background: radial-gradient(circle,
    rgba(216, 185, 144, 0.24) 0%,
    transparent 65%
  );
  pointer-events: none;
  z-index: 2;
  animation: glow-warm 5s ease-in-out infinite;
}

.final-content {
  position: relative;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: var(--s-16) var(--s-4);
  text-align: center;
}

/* Double-border photo frame */
.final-photo-frame {
  width: 100%;
  max-width: 500px;
  margin: 0 auto;
}

.final-frame-outer {
  padding: 10px;
  background: var(--card-primary);
  border: 1.5px solid rgba(189, 149, 107, 0.32);
  box-shadow: var(--shadow-photo);
}

.final-frame-inner {
  position: relative;
  aspect-ratio: 4 / 5;
  overflow: hidden;
  background: var(--card-secondary);
  border: 1px solid rgba(189, 149, 107, 0.12);
}

.final-frame-caption {
  text-align: center;
  margin-top: 0.75rem;
  opacity: 0.55;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  font-size: 0.58rem;
}

.final-signature {
  font-family: var(--font-script);
  font-size: clamp(1.4rem, 3vw, 2rem);
  color: var(--chestnut);
  margin-top: var(--s-6);
}

/* ════════════════════════════════════════════════
   RESPONSIVE — TABLET
════════════════════════════════════════════════ */
@media (max-width: 1100px) {
  .hero-layout { grid-template-columns: 1fr 1fr; }
  .hero-heading { font-size: clamp(2.4rem, 4.5vw, 4.2rem); }
  .hero-left { padding: var(--s-12) var(--s-6) var(--s-12) var(--s-6); }

  .gallery-grid { grid-auto-rows: 220px; }
  .gallery-item--featured { grid-column: span 7; }
  .gallery-item--wide { grid-column: span 7; }

  #lb-prev { left: -3rem; }
  #lb-next { right: -3rem; }
}

/* ════════════════════════════════════════════════
   RESPONSIVE — MOBILE
════════════════════════════════════════════════ */
@media (max-width: 768px) {
  /* Nav */
  .nav-menu-btn { display: flex; }
  .nav-links {
    position: fixed;
    top: 0; right: -100%;
    height: 100vh;
    width: min(280px, 80vw);
    flex-direction: column;
    justify-content: center;
    background: rgba(243, 231, 214, 0.97);
    backdrop-filter: blur(20px);
    padding: var(--s-8) var(--s-6);
    gap: var(--s-4);
    transition: right 0.45s var(--ease-out);
    box-shadow: -4px 0 30px rgba(73,50,36,0.12);
  }
  .nav-links.open { right: 0; }
  .nav-links a { font-size: 0.8rem; }
  #nav { padding: 1rem var(--s-3); }

  /* Hero — stacked */
  .hero-layout { grid-template-columns: 1fr; min-height: 100svh; }
  .hero-left {
    order: 2;
    padding: var(--s-8) var(--s-4);
    background: var(--cream);
  }
  .hero-right {
    order: 1;
    height: 50svh;
    min-height: 320px;
  }
  .hero-vertical-label { display: none; }
  .hero-num { display: none; }
  .hero-annotation { display: none; }
  .hero-heading { font-size: clamp(2.2rem, 8vw, 3.2rem); }

  /* Universe — nodes in flow */
  #universe-nodes {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    padding: var(--s-6) var(--s-4) var(--s-10);
    z-index: 7;
  }
  .universe-planet-card {
    position: static !important;
    width: 100% !important;
    max-width: 330px !important;
    transform: none !important;
  }
  .universe-node { position: static !important; animation: none !important; }
  .universe-orbit-ring { display: none; }
  .universe-center { position: static; transform: none;
    margin: var(--s-8) auto 0; padding: 0 var(--s-4); }
  .universe-heading-area { position: static; transform: none;
    padding: var(--s-8) var(--s-4) 0; }
  .universe-constellation-svg { display: none; }
  .universe-scroll-hint { display: none; }

  /* Gallery */
  .gallery-grid {
    grid-template-columns: 1fr 1fr;
    grid-auto-rows: 200px;
    gap: 8px;
  }
  .gallery-item--featured,
  .gallery-item--wide,
  .gallery-item--medium,
  .gallery-item--tall,
  .gallery-item--small { grid-column: span 1; grid-row: span 1; }

  /* Scrapbook */
  .scrapbook-grid {
    grid-template-columns: 1fr 1fr;
    grid-auto-rows: 180px;
    gap: 10px;
  }
  .scrap-card--large,
  .scrap-card--wide,
  .scrap-card--medium,
  .scrap-card--small { grid-column: span 1; grid-row: span 1; }

  /* Mosaic */
  .mosaic-grid {
    grid-template-columns: 1fr 1fr;
    grid-auto-rows: 180px;
    gap: 6px;
  }
  .mosaic-tile--large,
  .mosaic-tile--wide,
  .mosaic-tile--tall,
  .mosaic-tile { grid-column: span 1; grid-row: span 1; }

  /* Letter */
  .letter-envelope-wrap { max-width: 94vw; margin-top: 120px; margin-bottom: 30px; }
  .letter-env-outer { height: 260px; }
  .letter-card {
    padding: 1.8rem 1.4rem;
    min-height: 440px;
    top: 10px;
    left: 3%;
    right: 3%;
  }
  .letter-heading { font-size: 1.55rem; }
  .letter-para { font-size: 0.98rem; line-height: 1.95; }
  .vintage-postage-stamp { width: 50px; height: 60px; top: 10px; right: 12px; }
  .vintage-postmark { width: 72px; height: 72px; top: 14px; right: 38px; }
  .letter-env-seal { width: 50px; height: 50px; }
  .wax-seal-inner { width: 34px; height: 34px; }

  /* Secret */
  .secret-envelope-wrap { max-width: 90vw; margin-top: 80px; margin-bottom: 24px; }
  .secret-env-outer { height: 210px; }
  .secret-card {
    min-height: 220px;
    top: 8px;
    left: 4%;
    right: 4%;
    padding: 1.4rem 1.2rem;
  }

  /* Final */
  .final-photo-frame { max-width: 320px; }

  /* Lightbox */
  #lb-prev { left: 0.4rem; width: 36px; height: 36px; }
  #lb-next { right: 0.4rem; width: 36px; height: 36px; }
  .lightbox-close { top: -2.5rem; }
}

@media (max-width: 480px) {
  .intro-line { font-size: 1.5rem; }
  .intro-line--italic { font-size: 1.22rem; }
  #enter-btn { padding: 1rem 2rem; }
  .hero-heading { font-size: 2rem; }

  .gallery-grid, .scrapbook-grid, .mosaic-grid {
    grid-template-columns: 1fr;
    grid-auto-rows: 240px;
  }
}
