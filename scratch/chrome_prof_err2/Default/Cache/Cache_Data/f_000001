  <!-- GSAP -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

  <style>
    /* ── Critical inline CSS — prevents FOUC ── */
    html { background: #F3E7D6; }

    @media (max-width: 768px) {
      .lightbox-btn { touch-action: manipulation; }
    }

    /* Section label flanked by mocha lines */
    .eyebrow-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.4rem;
      margin-bottom: 1.2rem;
    }
    .eyebrow-row::before,
    .eyebrow-row::after {
      content: '';
      flex: 1;
      max-width: 80px;
      height: 1px;
      background: rgba(189, 149, 107, 0.35);
    }

    /* Fine dot separator */
    .dot-sep {
      display: inline-block;
      width: 3px; height: 3px;
      border-radius: 50%;
      background: currentColor;
      opacity: 0.35;
      vertical-align: middle;
      margin: 0 0.4rem;
    }

    /* Section number — small tracked label */
    .section-num {
      font-family: 'Manrope', sans-serif;
      font-size: 0.52rem;
      letter-spacing: 0.32em;
      color: #916F4C;
      text-transform: uppercase;
      display: block;
      margin-bottom: 0.9rem;
      text-align: center;
      opacity: 0; /* revealed by JS observer */
    }

    /* Universe central ambient glow */
    .universe-glow-center {
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      width: 60vmax; height: 60vmax;
      border-radius: 50%;
      background: radial-gradient(circle,
        rgba(216, 185, 144, 0.18) 0%,
        rgba(189, 149, 107, 0.07) 40%,
        transparent 70%
      );
      pointer-events: none;
      z-index: 1;
    }

    .scrapbook-edge { display: none !important; }

    /* Gallery → mosaic fade */
    .section-fade-bottom {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 140px;
      background: linear-gradient(to bottom, transparent, #EBD8C0);
      pointer-events: none;
      z-index: 2;
    }

    /* Corner ornament inline SVG */
    .corner-ornament-svg {
      position: absolute;
      width: 44px; height: 44px;
      opacity: 0.22;
      pointer-events: none;
      color: #8C6242;
    }
    .corner-ornament-svg--tl { top: 1.5rem; left: 1.5rem; }
    .corner-ornament-svg--tr { top: 1.5rem; right: 1.5rem; transform: scaleX(-1); }
    .corner-ornament-svg--bl { bottom: 1.5rem; left: 1.5rem; transform: scaleY(-1); }
    .corner-ornament-svg--br { bottom: 1.5rem; right: 1.5rem; transform: scale(-1); }
  </style>
</head>

<body>

  <!-- ══ CURSOR ══════════════════════════════════════════════════ -->
  <div id="cursor-dot"  aria-hidden="true"></div>
  <div id="cursor-ring" aria-hidden="true"></div>

  <!-- ══ LIGHTBOX ════════════════════════════════════════════════ -->
  <div id="lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer" tabindex="-1">
    <div class="lightbox-inner">
      <button id="lb-close" class="lightbox-close" aria-label="Close photo viewer">
