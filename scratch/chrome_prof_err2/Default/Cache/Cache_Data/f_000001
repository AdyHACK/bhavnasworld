      <span id="lb-counter" class="lightbox-counter" aria-live="polite" aria-atomic="true"></span>
      <button id="lb-prev" class="lightbox-btn" aria-label="Previous photo">&#8592;</button>
      <button id="lb-next" class="lightbox-btn" aria-label="Next photo">&#8594;</button>
